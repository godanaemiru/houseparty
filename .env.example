# Copy this file to .env and fill in real values before deploying anywhere real.
# (This app reads these via process.env — wire up a loader like `dotenv` in server/index.js
#  if you want a .env file to be picked up automatically; on most hosts you'll set these
#  as dashboard environment variables instead.)

# Required in production — a long random string used to sign login sessions.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Set to "production" on your host. Enables strict checks (e.g. requires JWT_SECRET).
NODE_ENV=development

# Comma-separated list of origins allowed to call this API / connect via Socket.IO.
# Example: https://myapp.com,https://www.myapp.com
# Leave unset in local development to allow any origin.
ALLOWED_ORIGINS=

# Port the server listens on (most hosts set this for you automatically).
PORT=3000

# How long a login session (JWT) stays valid. Shorter = safer if a token ever leaks.
# Accepts zeit/ms strings like "1d", "12h", "7d". Defaults to 7d.
JWT_EXPIRES_IN=7d

# Verbosity of the structured logger: trace|debug|info|warn|error|silent. Default: info.
LOG_LEVEL=info

# Max Postgres pool connections per instance (only used when DATABASE_URL is set). Default: 10.
PG_POOL_MAX=10

# --- Optional but strongly recommended for real use: TURN relay ---
# Without TURN, users behind symmetric NAT (many mobile carriers, corporate/university
# networks) can't establish a WebRTC mesh connection at all — STUN alone isn't enough.
# Point these at a TURN service (e.g. Twilio, Metered, or self-hosted coturn). TURN_URL
# may be a comma-separated list to offer udp + tcp/tls fallbacks.
# Example: TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Optional: LiveKit SFU mode (see README "Scaling video past ~8 people") ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
